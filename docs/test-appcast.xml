<?xml version="1.0" encoding="utf-8"?>
<!--
    TEST APPCAST for local development

    To test updates locally:
    1. cd docs
    2. python3 -m http.server 8000
    3. In Info.plist, set SUFeedURL to: http://localhost:8000/test-appcast.xml
    4. Build and run app
    5. Click "Check for Updates"
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" xmlns:dc="http://purl.org/dc/elements/1.1/">
    <channel>
        <title>ZetaNotes Updates (TEST)</title>
        <link>http://localhost:8000/test-appcast.xml</link>
        <description>Test updates for ZetaNotes development</description>
        <language>en</language>

        <!-- 🧪 TEST Version 1.1 -->
        <item>
            <title>Version 1.1 TEST</title>
            <link>https://github.com/YOUR_USERNAME/zetanotes</link>
            <sparkle:version>1.1</sparkle:version>
            <sparkle:shortVersionString>1.1</sparkle:shortVersionString>
            <description><![CDATA[
                <h2>🧪 Test Update - ZetaNotes 1.1</h2>
                <p><strong>This is a test update notification!</strong></p>

                <h3>What's New:</h3>
                <ul>
                    <li>🚀 <strong>Upgraded to Llama 3.2 1B</strong> - Better quality, same speed!</li>
                    <li>⚡ <strong>Lower memory usage</strong> - 1.2GB instead of 1.5GB</li>
                    <li>✨ <strong>Improved instruction-following</strong> - Meta's latest architecture</li>
                    <li>🎯 <strong>Same file size</strong> - Still ~80MB (no models bundled)</li>
                </ul>

                <p><em>Note: This test update won't actually install. It's just to verify the notification appears!</em></p>

                <h3>For Existing Users:</h3>
                <p>Your current model will be preserved. To try Llama 3.2 1B:</p>
                <ol>
                    <li>Go to <strong>Settings</strong> → <strong>AI Models</strong></li>
                    <li>Click <strong>Download</strong> next to "Llama 3.2 1B"</li>
                                        <li>Open the app (right-click → Open if first time)</li>
                    <li>Wait for download (~80 MB)</li>
                    <li>Restart ZetaNotes</li>
                    <li>Select it as your active model</li>
                </ol>
            ]]></description>
            <pubDate>Wed, 20 Oct 2025 12:00:00 +0000</pubDate>
            <enclosure
                url="http://localhost:8000/ZetaNotes-v1.1-TEST.dmg"
                sparkle:version="1.1"
                sparkle:shortVersionString="1.1"
                length="80000000"
                type="application/octet-stream"
                sparkle:edSignature="TEST_SIGNATURE_NOT_VALID" />
            <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
        </item>

        <!-- Version 1.0 - Current -->
        <item>
            <title>Version 1.0</title>
            <link>https://github.com/YOUR_USERNAME/zetanotes</link>
            <sparkle:version>1.0</sparkle:version>
            <sparkle:shortVersionString>1.0</sparkle:shortVersionString>
            <description><![CDATA[
                <h2>ZetaNotes 1.0 - Initial Release</h2>
                <p>Privacy-first note-taking with offline AI.</p>
                <ul>
                    <li>🔒 100% offline AI processing</li>
                    <li>✨ Smart autocomplete with TinyLlama</li>
                    <li>📝 Instant summarization</li>
                    <li>🌍 Translate to 12+ languages</li>
                    <li>🔍 Semantic search</li>
                </ul>
            ]]></description>
            <pubDate>Mon, 19 Oct 2025 00:00:00 +0000</pubDate>
            <enclosure
                url="http://localhost:8000/ZetaNotes-v1.0.dmg"
                sparkle:version="1.0"
                sparkle:shortVersionString="1.0"
