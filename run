#!/bin/zsh

# Clean, build, and run ZetaNotes in debug mode
# This script will clean the project, build it, and run the built application
# with console output visible in the terminal

set -e

echo "🧹 Cleaning project..."
xcodebuild -project ZetaNotes.xcodeproj -scheme ZetaNotes clean

echo "🔨 Building project..."
xcodebuild -project ZetaNotes.xcodeproj -scheme ZetaNotes build

echo "🚀 Running ZetaNotes in debug mode..."

# Find the built app and run it directly to see console output
echo "🔍 Looking for built app..."

# More comprehensive search for the built app
APP_PATH=""

# Search in common build locations
for BUILD_PATH in \
    "build/Debug/ZetaNotes.app" \
    "build/Release/ZetaNotes.app" \
    $(find "$HOME/Library/Developer/Xcode/DerivedData" -name "ZetaNotes.app" -type d 2>/dev/null | head -1)
do
    if [ -d "$BUILD_PATH" ]; then
        APP_PATH="$BUILD_PATH"
        echo "✅ Found app at: $APP_PATH"
        break
    fi
done

if [ -z "$APP_PATH" ]; then
    echo "❌ Could not find built app."
    echo "💡 Try building first or check Xcode build settings."
    exit 1
fi

echo "🔍 Running with console output (Press Ctrl+C to stop)..."
"$APP_PATH/Contents/MacOS/ZetaNotes"
