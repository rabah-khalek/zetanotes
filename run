#!/bin/zsh

# Clean, build, and run ZetaNotes
# This script will clean the project, build it, and then run the built application

set -e

echo "Cleaning project..."
xcodebuild -project ZetaNotes.xcodeproj -scheme ZetaNotes clean

echo "Building project..."
xcodebuild -project ZetaNotes.xcodeproj -scheme ZetaNotes build

echo "Running ZetaNotes..."
cd /Users/projects/Library/Developer/Xcode/DerivedData/ZetaNotes-*/Build/Products/Debug
./ZetaNotes.app/Contents/MacOS/ZetaNotes 2>&1

# Return to project root
cd /Users/projects/Documents/zetanotes
