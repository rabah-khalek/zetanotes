<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox REQUIRED for App Store distribution with In-App Purchases -->
	<!-- Note: llama.cpp requires special entitlements (JIT, unsigned memory) -->
	<!-- These may need additional review from Apple for App Store approval -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Network access for downloading AI models -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Hardened Runtime Entitlements (required for notarization) -->
	<!-- JIT compilation needed for llama.cpp Metal GPU acceleration -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- Unsigned executable memory needed for llama.cpp dynamic model loading -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- File Access for user-selected files -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
