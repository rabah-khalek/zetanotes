<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NOTE: App Sandbox disabled for direct distribution outside Mac App Store -->
	<!-- App Sandbox conflicts with llama.cpp's memory requirements and causes issues -->
	<!-- If distributing via Mac App Store in the future, re-enable sandbox and test thoroughly -->
	<!-- <key>com.apple.security.app-sandbox</key> -->
	<!-- <true/> -->

	<!-- Network access for downloading AI models -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Hardened Runtime Entitlements (required for notarization) -->
	<!-- JIT compilation needed for llama.cpp Metal GPU acceleration -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>

	<!-- Unsigned executable memory needed for llama.cpp dynamic model loading -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- File Access for user-selected files -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
