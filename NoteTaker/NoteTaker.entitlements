<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox disabled for easier distribution without code signing -->
	<!-- In production with code signing, enable sandbox and add specific entitlements -->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- Network access for downloading AI models only -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Removed: com.apple.security.files.user-selected.read-write -->
	<!-- Not needed - app only uses its own Application Support directory -->

	<!-- Note: keychain-access-groups entitlement requires code signing -->
	<!-- For unsigned development builds, the Keychain prompt is expected -->
	<!-- Click "Always Allow" when prompted to grant permanent access -->
</dict>
</plist>
